{
  "name": "kuzzle-application",
  "version": "1.0.0",
  "description": "Kuzzle application template",
  "author": "The Kuzzle Team <support@kuzzle.io>",
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "test": "vitest run --fileParallelism false",
    "dev": "NODE_ENV=development tsx watch app.ts",
    "lint": "eslint ./lib --ext .ts --config .eslintrc.json",
    "test:types": "tsc --noEmit"
  },
  "type": "module",
  "main": "dist/app.js",
  "license": "Apache-2.0",
  "dependencies": {
    "kuzzle": "2.56.0",
    "kuzzle-logger": "^1.6.0",
    "kuzzle-plugin-prometheus": "4.2.1"
  },
  "devDependencies": {
    "@types/node": "24",
    "eslint": "8.57.1",
    "eslint-plugin-kuzzle": "0.0.15",
    "tsx": "4.23.13",
    "typescript": "5.4.*",
    "vitest": "4.1.9"
  },
  "overrides": {
    "kuzzle-logger": "$kuzzle-logger"
  },
  "files": [
    "dist/**/*"
  ],
  "engines": {
    "node": ">=20.0.0 <25.0.0"
  }
}
